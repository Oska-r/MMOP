[sub_resource type="GDScript" id="GDScript_ouso4"]
script/source = "extends NavigationRegion3D

@export var world_environment: WorldEnvironment
@export var sun_damage : int

@onready var blocks: Node3D = $World_flexible/Blocks
var bake_queued: bool = false

func _ready():
	queue_bake()

func is_day():
	return world_environment.is_day

func queue_bake():
	if bake_queued:
		return
	bake_queued = true
	call_deferred(\"_do_bake\")

func _do_bake():
	await get_tree().physics_frame
	navigation_mesh = navigation_mesh.duplicate()
	call_deferred(\"bake_navigation_mesh\")
	bake_queued = false

func _on_world_flexible_child_order_changed() -> void:
	queue_bake()

## Signal from world environment.
func _on_world_environment_day_started() -> void:
	get_node(\"Spawn\").new_day()
"

[sub_resource type="Curve3D" id="Curve3D_blune"]
